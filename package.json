{
  "name": "dca-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "A DCA-optimized stock dashboard that surfaces dip opportunities for long-term investing, backed by live Yahoo Finance data.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:pages": "vite build --base=./",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "yahoo-finance2": "^3.15.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.0.7"
  }
}
